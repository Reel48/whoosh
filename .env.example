# Stripe — copy this file to .env.local and fill in the values.
# IMPORTANT: never commit real keys. .env.local is gitignored.

# Server-side secret key (test mode: sk_test_..., live mode: sk_live_...)
STRIPE_SECRET_KEY=

# Stripe Price IDs for the Whoosh Premium product.
# Create one product with three recurring prices and paste the price IDs here.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMI_ANNUAL=
STRIPE_PRICE_ANNUAL=

# Optional. Public origin used in Stripe success/cancel URLs.
# Leave blank in dev; set to https://whoosh.example.com in production.
NEXT_PUBLIC_SITE_URL=
