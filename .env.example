# Copy to .env.local and fill in. .env.local is gitignored.

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMI_ANNUAL=
STRIPE_PRICE_ANNUAL=
# Signing secret for the Stripe webhook endpoint (Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=

# --- Discord ---
# OAuth app credentials (Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token (Developer Portal → Bot)
DISCORD_BOT_TOKEN=
# Server (guild) the bot is in
DISCORD_GUILD_ID=
# Role to grant on successful subscription
DISCORD_PREMIUM_ROLE_ID=
# Role that gates the /admin portal — anyone with this Discord role can see
# the admin views.
DISCORD_ADMIN_ROLE_ID=
# Random string for signing the Discord login cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DISCORD_SESSION_SECRET=

# --- Site ---
# Public origin used in Stripe success/cancel + OAuth redirect URIs.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (Whoosh Bucks backend) ---
# Project URL: https://yjmohosxtemjamwrsffw.supabase.co
SUPABASE_URL=
# Service role key — Settings → API → service_role. Server-only; bypasses RLS.
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Auth header for Vercel Cron endpoints (`Authorization: Bearer $CRON_SECRET`).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=

# Optional: FRED API key (free at fred.stlouisfed.org). When set, the daily
# cron pulls the 3-month T-bill rate (DTB3) as a SPAXX yield proxy. When
# unset, the daily cron skips the rate refresh and keeps using the last
# known rate (default bootstrap: 2%).
FRED_API_KEY=

# Finnhub API key (free at finnhub.io/register). Used to fetch real-time
# US equity quotes for the simulated investing feature. Free tier: 60 req/min.
# Combined with the 60s symbol_quote cache, that's effectively unlimited
# throughput for a Discord-scale community.
FINNHUB_API_KEY=

# Twelve Data API key (free at twelvedata.com). Used for daily historical
# OHLC candles powering the /invest stock detail chart. Free tier:
# 800 req/day, 8 req/min — paired with a 1-hour per-(symbol,range) cache.
TWELVEDATA_API_KEY=

# --- The Odds API (sportsbook lines for /events) ---
# Key from the-odds-api.com. Powers the /api/cron/odds-sync (lines) and
# /api/cron/odds-settle (final scores) crons. Free tier = 500 credits/mo;
# the /odds call costs (markets × regions) credits per sport, so keep
# ODDS_SPORTS minimal on the free tier and upgrade ($30/mo = 20K) to widen.
ODDS_API_KEY=
# Comma list of enabled sport keys. Default (when unset) is all six:
#   americanfootball_nfl, americanfootball_ncaaf, basketball_nba,
#   baseball_mlb, soccer_epl, soccer_uefa_champs_league
# On the free tier, set this to only the in-season league(s) you want.
ODDS_SPORTS=
# Optional: comma list of markets (default: h2h,spreads,totals).
ODDS_MARKETS=
# Optional: preferred bookmaker key (e.g. draftkings). Falls back to the
# first book offering each market when unset.
ODDS_PRIMARY_BOOK=
